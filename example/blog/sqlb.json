            "org_id",
            "status"
          ]
        },
        {
          "name": "posts_author_id_idx",
          "columns": [
            "author_id"
          ]
        }
      ],
      "rest": {
        "path": "/posts",
        "operations": [
          "create",
          "read",
          "update",
          "list"
        ],
        "defaultPageSize": 20,
        "maxPageSize": 100,
        "maxFilters": 12,
        "filterable": [
          "id",
          "author_id",
          "title",
          "body",
          "status",
          "view_count",
          "published_at"
        ],
        "sortable": [
          "title",
          "status",
          "view_count",
          "published_at",
          "created_at",
          "updated_at"
        ],
        "searchable": [
          "title",
          "body"
        ],
        "expandable": [
          "author"
        ],
        "examples": [
