          "capabilities": [
            "filter",
            "sort"
          ]
        },
        {
          "name": "view_count",
          "type": "bigint",
          "goType": "int64",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "filter",
            "sort"
          ]
        },
        {
          "name": "published_at",
          "type": "timestamptz",
          "goType": "*time.Time",
          "nullable": true,
          "capabilities": [
            "filter",
            "sort"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        },
        {
          "name": "deleted_at",
          "type": "timestamptz",
          "goType": "*time.Time",
          "nullable": true,
          "readOnly": true,
          "softDelete": true
        }
      ],
