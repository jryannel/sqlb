{
  "version": "1",
  "tables": [
    {
      "name": "authors",
      "primaryKey": "id",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "goType": "string",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "filter"
          ]
        },
        {
          "name": "org_id",
          "type": "uuid",
          "goType": "string",
          "capabilities": [
            "filter",
            "expand"
          ],
          "references": {
            "relation": "org",
            "table": "orgs",
            "column": "id",
            "onDelete": "CASCADE",
            "enforced": true
          }
        },
        {
          "name": "email",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "search"
          ]
        },
        {
          "name": "name",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "sort",
            "search"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        }
      ],
      "indexes": [
        {
          "name": "authors_org_id_idx",
          "columns": [
            "org_id"
          ]
        }
      ],
      "collectedBy": [
        {
          "name": "posts",
          "table": "posts",
          "column": "author_id",
          "order": "-published_at",
          "limit": 2,
          "expandable": true
        }
      ],
      "rest": {
        "path": "/authors",
        "operations": [
          "create",
          "read",
          "update",
          "delete",
          "list"
        ],
        "defaultPageSize": 25,
        "maxPageSize": 100,
        "filterable": [
          "id",
          "org_id",
          "email",
          "name"
        ],
        "sortable": [
          "name",
          "created_at",
          "updated_at"
        ],
        "searchable": [
          "email",
          "name"
        ],
        "expandable": [
          "org",
          "posts"
        ],
        "examples": [
          "GET /authors?id=eq.VALUE",
          "GET /authors?sort=-name\u0026page=2\u0026per_page=20",
          "GET /authors?search=TERM",
          "GET /authors?expand=org",
          "GET /authors?or=(id.eq.A,org_id.eq.B)"
        ]
      }
    },
