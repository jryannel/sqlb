    {
      "name": "posts",
      "comment": "A blog post.",
      "primaryKey": "id",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "goType": "string",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "filter"
          ]
        },
        {
          "name": "org_id",
          "type": "uuid",
          "goType": "string",
          "references": {
            "relation": "org",
            "table": "orgs",
            "column": "id",
            "onDelete": "CASCADE",
            "enforced": true
          }
        },
        {
          "name": "author_id",
          "type": "uuid",
          "goType": "string",
          "capabilities": [
            "filter",
            "expand"
          ],
          "references": {
