    {
      "name": "tickets",
      "comment": "One request from one customer.",
      "primaryKey": "id",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "goType": "string",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "filter"
          ]
        },
        {
          "name": "customer_id",
          "type": "uuid",
          "goType": "string",
          "capabilities": [
            "filter",
            "expand"
          ],
          "references": {
            "relation": "customer",
            "table": "customers",
            "column": "id",
            "onDelete": "CASCADE",
            "enforced": true
          }
        },
        {
          "name": "subject",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "sort",
            "search"
          ]
        },
        {
          "name": "body",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "search"
          ]
        },
        {
          "name": "status",
          "type": "enum",
          "goType": "string",
          "enum": [
            "open",
            "pending",
            "closed"
          ],
          "hasDefault": true,
          "capabilities": [
            "filter",
            "sort"
          ]
        },
        {
          "name": "priority",
          "type": "enum",
          "goType": "string",
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ],
          "hasDefault": true,
          "capabilities": [
            "filter",
            "sort"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        }
      ],
      "indexes": [
        {
          "name": "tickets_customer_id_status_idx",
          "columns": [
            "customer_id",
            "status"
          ]
        }
      ],
      "rest": {
        "path": "/tickets",
        "operations": [
          "create",
          "read",
          "update",
          "list"
        ],
        "defaultPageSize": 20,
        "maxPageSize": 100,
        "filterable": [
          "id",
          "customer_id",
          "subject",
          "body",
          "status",
          "priority"
        ],
        "sortable": [
          "subject",
          "status",
          "priority",
          "created_at",
          "updated_at"
        ],
        "searchable": [
          "subject",
          "body"
        ],
        "expandable": [
          "customer"
        ],
        "examples": [
          "GET /tickets?id=eq.VALUE",
          "GET /tickets?sort=-subject\u0026page=2\u0026per_page=20",
          "GET /tickets?search=TERM",
          "GET /tickets?expand=customer",
          "GET /tickets?or=(id.eq.A,customer_id.eq.B)"
        ]
      }
    }
  ],
  "filterOperators": [
    {
      "name": "eq",
      "form": "col=eq.VALUE (or col=VALUE)",
      "applies": "any filterable column"
    },
    {
      "name": "ne",
      "form": "col=ne.VALUE",
      "applies": "any filterable column"
    },
    {
      "name": "gt",
      "form": "col=gt.VALUE",
      "applies": "ordered columns"
    },
    {
      "name": "gte",
      "form": "col=gte.VALUE",
      "applies": "ordered columns"
    },
    {
      "name": "lt",
      "form": "col=lt.VALUE",
      "applies": "ordered columns"
    },
    {
      "name": "lte",
      "form": "col=lte.VALUE",
      "applies": "ordered columns"
    },
    {
      "name": "in",
      "form": "col=in.A,B,C",
      "applies": "any filterable column"
    },
    {
      "name": "nin",
      "form": "col=nin.A,B",
      "applies": "any filterable column"
    },
    {
      "name": "between",
      "form": "col=between.LO,HI",
      "applies": "ordered columns"
    },
    {
      "name": "isnull",
      "form": "col=isnull",
      "applies": "nullable columns"
    },
    {
      "name": "notnull",
      "form": "col=notnull",
      "applies": "nullable columns"
    },
    {
      "name": "contains",
      "form": "col=contains.TEXT",
      "applies": "text columns; wildcards escaped"
    },
    {
      "name": "startswith",
      "form": "col=startswith.TEXT",
      "applies": "text columns; wildcards escaped"
    },
    {
      "name": "endswith",
      "form": "col=endswith.TEXT",
      "applies": "text columns; wildcards escaped"
    },
    {
      "name": "like",
      "form": "col=like.PATTERN",
      "applies": "text columns; wildcards NOT escaped"
    },
    {
      "name": "ilike",
      "form": "col=ilike.PATTERN",
      "applies": "text columns; wildcards NOT escaped"
    }
  ],
  "reservedParams": [
    {
      "name": "select",
      "form": "select=id,name — projection; the primary key is always included"
    },
    {
      "name": "sort",
      "form": "sort=-created_at,name — leading '-' is descending"
    },
    {
      "name": "search",
      "form": "search=TERM — fans out over searchable columns"
    },
    {
      "name": "page",
      "form": "page=2 — 1-based"
    },
    {
      "name": "per_page",
      "form": "per_page=50 — capped by maxPageSize"
    },
    {
      "name": "limit",
      "form": "limit=50 — alternative to per_page"
    },
    {
      "name": "offset",
      "form": "offset=100 — alternative to page"
    },
    {
      "name": "or",
      "form": "or=(a.eq.1,b.gt.2) — explicit disjunction, nestable"
    },
    {
      "name": "and",
      "form": "and=(a.eq.1,b.gt.2) — explicit conjunction"
    },
    {
      "name": "not",
      "form": "not=(a.eq.1,b.gt.2) — negation; several conditions are NOT (a AND b)"
    }
  ]
}
