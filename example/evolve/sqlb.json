          "type": "text",
          "goType": "string"
        },
        {
          "name": "name",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "sort",
            "search"
          ]
        },
        {
          "name": "active",
          "type": "bool",
          "goType": "bool",
          "hasDefault": true,
          "capabilities": [
            "filter"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz",
