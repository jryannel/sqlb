{
  "version": "1",
  "tables": [
    {
      "name": "customers",
      "comment": "Whoever a ticket is on behalf of.",
      "primaryKey": "id",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "goType": "string",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "filter"
          ]
        },
        {
          "name": "email_address",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "search"
          ]
        },
        {
          "name": "name",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "sort",
            "search"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        }
      ],
      "rest": {
        "path": "/customers",
        "operations": [
          "create",
          "read",
          "update",
          "list"
        ],
        "defaultPageSize": 25,
        "maxPageSize": 100,
        "filterable": [
          "id",
          "email_address",
          "name"
        ],
        "sortable": [
          "name",
          "created_at",
          "updated_at"
        ],
        "searchable": [
          "email_address",
          "name"
        ],
        "examples": [
          "GET /customers?id=eq.VALUE",
          "GET /customers?sort=-name\u0026page=2\u0026per_page=20",
          "GET /customers?search=TERM",
          "GET /customers?or=(id.eq.A,email_address.eq.B)"
        ]
      }
    },
    {
