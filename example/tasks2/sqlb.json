{
  "version": "1",
  "tables": [
    {
      "name": "lists",
      "comment": "A group of tasks.",
      "primaryKey": "id",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "goType": "string",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "filter"
          ]
        },
        {
          "name": "name",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "sort",
            "search"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        }
      ],
      "rest": {
        "path": "/lists",
        "operations": [
          "create",
          "read",
          "update",
          "delete",
          "list"
        ],
        "defaultPageSize": 25,
        "maxPageSize": 100,
        "filterable": [
          "id",
          "name"
        ],
        "sortable": [
          "name",
          "created_at",
          "updated_at"
        ],
        "searchable": [
          "name"
        ],
        "examples": [
          "GET /lists?id=eq.VALUE",
          "GET /lists?sort=-name\u0026page=2\u0026per_page=20",
          "GET /lists?search=TERM",
          "GET /lists?or=(id.eq.A,name.eq.B)"
        ]
      }
    },
    {
      "name": "tasks",
      "comment": "A unit of work, belonging to one list.",
      "primaryKey": "id",
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "goType": "string",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "filter"
          ]
        },
        {
          "name": "list_id",
          "type": "uuid",
          "goType": "string",
          "capabilities": [
            "filter"
          ],
          "references": {
            "relation": "list",
            "table": "lists",
            "column": "id",
            "onDelete": "CASCADE",
            "enforced": true
          }
        },
        {
          "name": "title",
          "type": "text",
          "goType": "string",
          "capabilities": [
            "filter",
            "sort",
            "search"
          ]
        },
        {
          "name": "status",
          "type": "enum",
          "goType": "string",
          "enum": [
            "todo",
            "done"
          ],
          "hasDefault": true,
          "capabilities": [
            "filter",
            "sort"
          ]
        },
        {
          "name": "due_at",
          "type": "timestamptz",
          "goType": "*time.Time",
          "nullable": true,
          "capabilities": [
            "filter",
            "sort"
          ]
        },
        {
          "name": "completed_at",
          "type": "timestamptz",
          "goType": "*time.Time",
          "nullable": true,
          "readOnly": true,
          "capabilities": [
            "filter",
            "sort"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "goType": "time.Time",
          "hasDefault": true,
          "readOnly": true,
          "capabilities": [
            "sort"
          ]
        }
      ],
      "indexes": [
        {
          "name": "tasks_list_id_idx",
          "columns": [
            "list_id"
          ]
        },
        {
          "name": "tasks_due_at_idx",
          "columns": [
            "due_at"
          ]
        }
      ],
      "rest": {
        "path": "/tasks",
        "operations": [
          "create",
          "read",
          "update",
          "delete",
          "list"
        ],
        "defaultPageSize": 25,
        "maxPageSize": 100,
        "maxFilters": 8,
        "filterable": [
          "id",
          "list_id",
          "title",
          "status",
          "due_at",
          "completed_at"
        ],
        "sortable": [
          "title",
          "status",
          "due_at",
          "completed_at",
          "created_at",
          "updated_at"
        ],
        "searchable": [
          "title"
        ],
        "actions": [
          {
            "name": "clear-completed",
            "path": "/tasks/clear-completed",
            "method": "POST",
            "body": [
              {
                "name": "list_id",
                "type": "uuid",
                "nullable": true
              }
            ]
          }
        ],
        "examples": [
          "GET /tasks?id=eq.VALUE",
          "GET /tasks?sort=-title\u0026page=2\u0026per_page=20",
          "GET /tasks?search=TERM",
          "GET /tasks?or=(id.eq.A,list_id.eq.B)"
        ]
      }
    }
  ],
  "filterOperators": [
    {
      "name": "eq",
      "form": "col=eq.VALUE (or col=VALUE)",
      "applies": "any filterable column"
    },
    {
      "name": "ne",
      "form": "col=ne.VALUE",
      "applies": "any filterable column"
    },
    {
      "name": "gt",
      "form": "col=gt.VALUE",
      "applies": "ordered columns"
    },
    {
      "name": "gte",
      "form": "col=gte.VALUE",
      "applies": "ordered columns"
    },
    {
      "name": "lt",
      "form": "col=lt.VALUE",
      "applies": "ordered columns"
    },
    {
      "name": "lte",
      "form": "col=lte.VALUE",
      "applies": "ordered columns"
    },
    {
      "name": "in",
      "form": "col=in.A,B,C",
      "applies": "any filterable column"
    },
    {
      "name": "nin",
      "form": "col=nin.A,B",
      "applies": "any filterable column"
    },
    {
      "name": "between",
      "form": "col=between.LO,HI",
      "applies": "ordered columns"
    },
    {
      "name": "isnull",
      "form": "col=isnull",
      "applies": "nullable columns"
    },
    {
      "name": "notnull",
      "form": "col=notnull",
      "applies": "nullable columns"
    },
    {
      "name": "contains",
      "form": "col=contains.TEXT",
      "applies": "text columns; wildcards escaped"
    },
    {
      "name": "startswith",
      "form": "col=startswith.TEXT",
      "applies": "text columns; wildcards escaped"
    },
    {
      "name": "endswith",
      "form": "col=endswith.TEXT",
      "applies": "text columns; wildcards escaped"
    },
    {
      "name": "like",
      "form": "col=like.PATTERN",
      "applies": "text columns; wildcards NOT escaped"
    },
    {
      "name": "ilike",
      "form": "col=ilike.PATTERN",
      "applies": "text columns; wildcards NOT escaped"
    }
  ],
  "reservedParams": [
    {
      "name": "select",
      "form": "select=id,name — projection; the primary key is always included"
    },
    {
      "name": "sort",
      "form": "sort=-created_at,name — leading '-' is descending"
    },
    {
      "name": "search",
      "form": "search=TERM — fans out over searchable columns"
    },
    {
      "name": "page",
      "form": "page=2 — 1-based"
    },
    {
      "name": "per_page",
      "form": "per_page=50 — capped by maxPageSize"
    },
    {
      "name": "limit",
      "form": "limit=50 — alternative to per_page"
    },
    {
      "name": "offset",
      "form": "offset=100 — alternative to page"
    },
    {
      "name": "or",
      "form": "or=(a.eq.1,b.gt.2) — explicit disjunction, nestable"
    },
    {
      "name": "and",
      "form": "and=(a.eq.1,b.gt.2) — explicit conjunction"
    },
    {
      "name": "not",
      "form": "not=(a.eq.1,b.gt.2) — negation; several conditions are NOT (a AND b)"
    }
  ]
}
